{
  "name": "@sigil/core",
  "version": "0.1.0",
  "description": "Webhook signing, verification and delivery-retry policy. Deterministic, dependency-free, and the single source of truth for Sigil's signature format.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fairsplitt/sigil-core.git"
  },
  "keywords": [
    "webhook",
    "hmac",
    "signature",
    "verification",
    "retry"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.0.18"
  }
}
